{
  "name": "@leing2021/pi-search",
  "version": "0.4.2",
  "description": "Unified search extension for Pi Coding Agent — ripgrep code search + mgrep semantic search + DuckDuckGo fallback. Least-privilege sandbox, safe web retrieval, token-aware output.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "search",
    "mgrep",
    "ripgrep",
    "web-search",
    "duckduckgo",
    "semantic-search",
    "pi-search"
  ],
  "author": "Jason Le",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leing2021/pi-search.git"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "README_CN.md",
    "docs/security-policy.md",
    "docs/test-report.md"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/pi-search.ts"
    ]
  }
}
